# Changes on top of ROCKNIX's SM8250 config for a Debian userland.
# Booted by OpenABL via BLS with an external initramfs (initramfs-tools).
CONFIG_INITRAMFS_SOURCE=""
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set
# Ship an uncompressed Image with EFI stub, like ROCKNIX does
# CONFIG_EFI_ZBOOT is not set

# Read-only root / A-B slots / overlays
CONFIG_OVERLAY_FS=y
CONFIG_EROFS_FS=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=m
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y

# systemd conveniences
CONFIG_PSI=y
CONFIG_ZRAM=m
