{
  "name": "Siv3D ゲーム集",
  "exeName": "siv3d-games",
  "version": "0.1.0",
  "bundleId": "jp.hako.siv3d-games",
  "company": "",
  "copyright": "",

  "siv3d": {
    "repository": "https://github.com/wtnbgo/OpenSiv3D.git",
    "ref": "a8a1f4d0bb845143540dca9947b47a39b14231e9"
  },

  "assets": [
    { "from": "assets", "to": "assets" }
  ],

  "linux": {
    "container": "deckbuild-sniper",
    "package": ["tar.gz"]
  },
  "rpmini": {
    "name": "Siv3D ゲーム集",
    "container": "deckbuild-rpmini",
    "device": "root@192.168.7.2",
    "package": ["tar.gz"],
    "cmake": {
      "options": {
        "SIV3D_WITH_FFMPEG": "OFF",
        "SIV3D_WITH_MOVIEPLAYER": "OFF"
      }
    }
  },
  "windows": {
    "console": false,
    "package": ["zip"]
  }
}
