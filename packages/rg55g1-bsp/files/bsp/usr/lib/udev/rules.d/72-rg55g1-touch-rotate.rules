# Touch panel rotation for the cage session (hako-session).
# cage (wlroots) maps touch to the whole layout without the output transform,
# so libinput rotates the touch coordinates instead. Must match HAKO_ROTATE
# (/usr/lib/hako/session.d/10-rg55g1.sh):
#   270: "0 1 0 -1 0 1"   (standard)
#    90: "0 -1 1 1 0 0"
#   180: "-1 0 1 0 -1 1"
# Only the built-in panel (FocalTech on I2C); USB touch monitors keep their own
# orientation. Checked on the device (panel at platform-984000.i2c).
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ENV{ID_INPUT_TOUCHSCREEN}=="1", ENV{ID_BUS}!="usb", ENV{LIBINPUT_CALIBRATION_MATRIX}="0 1 0 -1 0 1"
