#!/bin/sh
# Volume keys handler (called by triggerhappy as root): volume up|down
#
# With the game session running, change the PipeWire volume of the default
# output of user hako (5 % steps; WirePlumber keeps the level across reboots).
# Without PipeWire, hand over to the board's hardware handler
# /usr/lib/hako/hw/volume if there is one.
case "$1" in
up)   d=5%+ ;;
down) d=5%- ;;
*) echo "usage: $0 up|down" >&2; exit 2 ;;
esac

uid=$(id -u hako 2>/dev/null) || uid=
if [ -n "$uid" ] && [ -S "/run/user/$uid/pipewire-0" ] && command -v wpctl >/dev/null; then
	exec runuser -u hako -- env XDG_RUNTIME_DIR="/run/user/$uid" \
		DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
		wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "$d"
fi
[ -x /usr/lib/hako/hw/volume ] && exec /usr/lib/hako/hw/volume "$1"
exit 0
