<ns0:RootFileSystem xmlns:ns0="https://www.linutronix.de/projects/Elbe"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	created="2026-11-19T10:00:00" revision="6"
	xsi:schemaLocation="https://www.linutronix.de/projects/Elbe dbsfed.xsd">
	<!--
	  hako development image (Debian trixie arm64) for the Anbernic RG 55G1 (SM4450).
	  Build with scripts/build-image.sh dev (it prepares the overlay and the local repo).

	  Disk (GPT, written to a microSD card):
	    1 ESP    vfat  256MiB  /boot/efi  loader/entries/rg55g1.conf, rg55g1/{Image,initrd.img}, dtbs/
	    2 rootA  ext4  6GiB    /          (rw in the dev image)
	    3 data   ext4  rest    /data      (hako-base grows it to the end of the card on the first boot)
	-->
	<project>
		<name>rg55g1-dev</name>
		<version>0.1</version>
		<description>Anbernic RG 55G1 development image</description>
		<buildtype>aarch64</buildtype>
		<mirror>
			<primary_host>deb.debian.org</primary_host>
			<primary_path>/debian</primary_path>
			<primary_proto>http</primary_proto>
			<url-list>
				<url>
					<binary>http://deb.debian.org/debian trixie non-free-firmware</binary>
				</url>
				<url>
					<binary>http://deb.debian.org/debian trixie-updates main non-free-firmware</binary>
				</url>
				<url>
					<binary>http://deb.debian.org/debian-security trixie-security main non-free-firmware</binary>
				</url>
				<repodir>../repo trixie main</repodir>
			</url-list>
		</mirror>
		<suite>trixie</suite>
	</project>
	<target>
		<hostname>rg55g1</hostname>
		<domain>local</domain>
		<!-- ELBE wants "device,baud"; the SoC debug UART (not wired out on the device) -->
		<console>ttyMSM0,115200</console>
		<debootstrap>
			<variant>minbase</variant>
		</debootstrap>
		<images>
			<gpthd>
				<name>rg55g1-dev.img</name>
				<size>7GiB</size>
				<partition>
					<size>256MiB</size>
					<label>ESP</label>
					<name>ESP</name>
					<bootable/>
				</partition>
				<partition>
					<size>6GiB</size>
					<label>rootA</label>
					<name>rootA</name>
				</partition>
				<partition>
					<size>remain</size>
					<label>data</label>
					<name>data</name>
				</partition>
			</gpthd>
		</images>
		<fstab>
			<bylabel>
				<label>rootA</label>
				<mountpoint>/</mountpoint>
				<fs>
					<type>ext4</type>
				</fs>
				<options>rw,noatime</options>
			</bylabel>
			<bylabel>
				<label>ESP</label>
				<mountpoint>/boot/efi</mountpoint>
				<fs>
					<type>vfat</type>
				</fs>
				<options>umask=0077</options>
			</bylabel>
			<bylabel>
				<label>data</label>
				<mountpoint>/data</mountpoint>
				<fs>
					<type>ext4</type>
				</fs>
				<options>noatime,nofail</options>
			</bylabel>
		</fstab>
		<finetuning>
			<command>chmod 700 /root/.ssh; chmod 600 /root/.ssh/authorized_keys</command>
			<command>systemctl enable systemd-networkd rg55g1-usb-gadget iwd triggerhappy</command>
			<!-- The kernel may be installed before initramfs-tools / rg55g1-bsp, so create the
			     initrd here (-c), and make the ESP mountpoint (ELBE creates it only later) so
			     rg55g1-update-esp can fill it; ELBE then copies /boot/efi into the FAT partition. -->
			<!-- ELBE leaves its build-time repo (10.0.2.2) in sources.list; it is unreachable on the device -->
			<command>sed -i "/10.0.2.2/d" /etc/apt/sources.list</command>
			<command>mkdir -p /boot/efi</command>
			<command>update-initramfs -c -k all</command>
			<command>rg55g1-update-esp</command>
			<command>ls -lR /boot/efi</command>
			<rm>/var/cache/apt/archives/*.deb</rm>
		</finetuning>
		<project-finetuning>
			<set_packer packer="none">rg55g1-dev.img</set_packer>
		</project-finetuning>
		<pkg-list>
			<pkg>systemd-sysv</pkg>
			<pkg>udev</pkg>
			<pkg>kmod</pkg>
			<pkg>e2fsprogs</pkg>
			<pkg>dosfstools</pkg>
			<pkg>initramfs-tools</pkg>
			<pkg>linux-image-7.2.0-sm4450</pkg>
			<pkg>rg55g1-bsp</pkg>
			<pkg>hako-base</pkg>
			<pkg>hako-session</pkg>
			<pkg>hako-dev</pkg>
			<pkg>hako-launcher</pkg>
			<pkg>hako-sdl-hello</pkg>
			<pkg>hako-love</pkg>
			<pkg>hako-raylib-hello</pkg>
			<pkg>hako-siv3d-games</pkg>
			<pkg>hako-raylib-classics</pkg>
		</pkg-list>
	</target>
	<!-- generated by scripts/build-image.sh: root's authorized_keys etc. -->
	<archivedir>../build/elbe/overlay</archivedir>
</ns0:RootFileSystem>
